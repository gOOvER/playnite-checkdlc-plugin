<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectGuid>{4FDF1E89-5BC3-4C72-8FDA-0D580E7A5D5F}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>CheckDlc</RootNamespace>
    <AssemblyName>CheckDlc</AssemblyName>
    <TargetFramework>net462</TargetFramework>
    <UseWpf>true</UseWpf>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>10.0</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);NU1902;NU1903;MSB3277</NoWarn>
  </PropertyGroup>

  <!-- In a class library, App.xaml must be a Page, not an ApplicationDefinition -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!-- Exclude playnite-plugincommon from default globbing to control inclusions explicitly -->
  <ItemGroup>
    <Compile Remove="playnite-plugincommon\**" />
    <Page Remove="playnite-plugincommon\**" />
    <None Remove="playnite-plugincommon\**" />
  </ItemGroup>

  <!-- Framework References -->
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Management" />
    <Reference Include="System.Web" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsBase" />
    <Reference Include="WindowsFormsIntegration" />
  </ItemGroup>

  <!-- Binary Dependencies -->
  <ItemGroup>
    <Reference Include="HtmlRenderer">
      <HintPath>Resources\PlayniteResources\HtmlRenderer.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="HtmlRenderer.WPF">
      <HintPath>Resources\PlayniteResources\HtmlRenderer.WPF.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <!-- NuGet Package References -->
  <ItemGroup>
    <PackageReference Include="PlayniteSDK" Version="6.16.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="10.0.3">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="AngleSharp" Version="0.9.9">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="FuzzySharp" Version="2.0.2" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="protobuf-net" Version="3.2.26" />
    <PackageReference Include="SteamKit2" Version="2.5.0" />
    <PackageReference Include="System.IO.Abstractions" Version="2.1.0.227" />
    <PackageReference Include="YamlDotNet" Version="5.4.0" />
  </ItemGroup>

  <!-- Shared Projects and Project References -->
  <ItemGroup>
    <ProjectReference Include="playnite-plugincommon\CommonPluginsResources\CommonPluginsResources.csproj">
      <Project>{4effe926-9c64-4750-a399-f344710edc09}</Project>
      <Name>CommonPluginsResources</Name>
    </ProjectReference>
  </ItemGroup>

  <Import Project="playnite-plugincommon\CommonPlayniteShared\CommonPlayniteShared.projitems" Label="Shared" />
  <Import Project="playnite-plugincommon\CommonPluginsShared\CommonPluginsShared.projitems" Label="Shared" />
  <Import Project="playnite-plugincommon\CommonPluginsStores\CommonPluginsStores.projitems" Label="Shared" />

  <!-- Selected CommonPluginsControls Items -->
  <ItemGroup>
    <Compile Include="playnite-plugincommon\CommonPluginsControls\Controls\TextBlockTrimmed.xaml.cs">
      <DependentUpon>TextBlockTrimmed.xaml</DependentUpon>
    </Compile>
    <Compile Include="playnite-plugincommon\CommonPluginsControls\PlayniteControls\NumericBox.xaml.cs">
      <DependentUpon>NumericBox.xaml</DependentUpon>
    </Compile>
    <Compile Include="playnite-plugincommon\CommonPluginsControls\Stores\Epic\PanelView.xaml.cs">
      <DependentUpon>PanelView.xaml</DependentUpon>
    </Compile>
    <Compile Include="playnite-plugincommon\CommonPluginsControls\Stores\Epic\PanelViewModel.cs" />
    <Compile Include="playnite-plugincommon\CommonPluginsControls\Stores\Gog\PanelView.xaml.cs">
      <DependentUpon>PanelView.xaml</DependentUpon>
    </Compile>
    <Compile Include="playnite-plugincommon\CommonPluginsControls\Stores\Gog\PanelViewModel.cs" />
    <Compile Include="playnite-plugincommon\CommonPluginsControls\Stores\Steam\PanelView.xaml.cs">
      <DependentUpon>PanelView.xaml</DependentUpon>
    </Compile>
    <Compile Include="playnite-plugincommon\CommonPluginsControls\Stores\Steam\PanelViewModel.cs" />
    <Compile Include="playnite-plugincommon\CommonPluginsControls\Views\OptionsDownloadData.xaml.cs">
      <DependentUpon>OptionsDownloadData.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Page Include="playnite-plugincommon\CommonPluginsControls\Controls\TextBlockTrimmed.xaml" />
    <Page Include="playnite-plugincommon\CommonPluginsControls\PlayniteControls\NumericBox.xaml" />
    <Page Include="playnite-plugincommon\CommonPluginsControls\Stores\Epic\PanelView.xaml" />
    <Page Include="playnite-plugincommon\CommonPluginsControls\Stores\Gog\PanelView.xaml" />
    <Page Include="playnite-plugincommon\CommonPluginsControls\Stores\Steam\PanelView.xaml" />
    <Page Include="playnite-plugincommon\CommonPluginsControls\Views\OptionsDownloadData.xaml" />
  </ItemGroup>

  <!-- Localization files must be copied to output, not compiled into BAML -->
  <ItemGroup>
    <Page Remove="Localization\**" />
    <Content Include="Localization\*.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Assets to copy to output directory -->
  <ItemGroup>
    <None Update="extension.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="Resources\PlayniteResources\HtmlRenderer.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\PlayniteResources\HtmlRenderer.WPF.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>